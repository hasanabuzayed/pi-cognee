# pi-cognee configuration.
#
# Copy to ~/.cognee/.env (shared with the official Claude Code / Codex cognee
# plugins) or export in your shell — shell exports always win over the file.
# Lines may start with `export ` and quotes are optional. Last value wins.

# ── Cloud / remote server mode ───────────────────────────────────────────
# Point at Cognee Cloud or your own self-run cognee API server:
# COGNEE_BASE_URL="https://your-instance.cognee.ai"
# COGNEE_API_KEY="ck_..."

# ── Local mode (default when COGNEE_BASE_URL is unset) ───────────────────
# pi-cognee BOOTS the local server automatically (v0.4): uv venv + pinned
# cognee (1.6.0) + detached uvicorn on http://localhost:8011, single-flighted
# with the Claude Code / Codex plugins via the shared ~/.cognee-plugin state.
# A running server is adopted as-is; only a positively-absent one is booted.
# The local server needs an LLM key (pass-through, used by the server only):
# LLM_API_KEY="sk-..."
# LLM_MODEL="gpt-4o-mini"
#
# Opt out of the bootstrap (v0.3 behavior — never install, never spawn; run the
# server yourself: DEFAULT_USER_PASSWORD=default_password \
#   uvicorn cognee.api.client:app --port 8011):
# COGNEE_LOCAL_BOOTSTRAP=on
#
# Cognee >= 1.2.2 enforces auth even on localhost. When COGNEE_API_KEY is unset,
# pi-cognee logs in as the default user and auto-mints an owner key (cached in
# ~/.cognee-plugin/api_key.json, shared with the official plugins). For that to
# work the login credentials must match the server's DEFAULT_USER_* values:
# COGNEE_USER_EMAIL="default_user@example.com"
# COGNEE_USER_PASSWORD="default_password"
# Or skip the mint with an explicit key:
# COGNEE_API_KEY="ck_..."
#
# Local server URL override (default http://localhost:8011):
# COGNEE_LOCAL_API_URL="http://localhost:8011"
#
# Bootstrap tuning (rarely needed):
# COGNEE_SERVER_BOOT_DEADLINE=600   # seconds; health wait after the spawn
# COGNEE_INSTALL_TIMEOUT=600        # seconds; per uv subprocess (lock window +60)
# COGNEE_PLUGIN_PYTHON=3.12         # python pin for `uv venv`
# COGNEE_PRESENCE_REPROBE_DELAY=3   # seconds before the absence-confirm re-probe
# COGNEE_PLUGIN_LOG_MAX_BYTES=20971520  # ~/.cognee-plugin/pi/bootstrap.log cap

# ── Mode pinning ─────────────────────────────────────────────────────────
# COGNEE_BACKEND=local   (aliases: native, sdk)
# COGNEE_BACKEND=cloud   (aliases: http, api, server) — needs COGNEE_BASE_URL
# Plugin-specific pin that beats the shared one:
# COGNEE_PI_BACKEND=local

# ── Memory scoping ───────────────────────────────────────────────────────
# Dataset for graph memory. Default "agent_sessions" is shared with the
# Claude Code and Codex cognee plugins — set per project for isolated memory:
# COGNEE_PLUGIN_DATASET="agent_sessions"
# COGNEE_SESSION_PREFIX="pi"
# COGNEE_SESSION_ID="pi_my-fixed-session"

# Federated graph reads (optional, read-only federation — same as the official
# plugins): a JSON array of dataset UUIDs that widens GRAPH recall across
# datasets you granted yourself. UUID-only entries (hyphens optional, case-
# insensitive), canonicalized and deduped. Writes, sync, and session memory
# stay on the single session dataset; an explicit dataset argument cannot
# narrow a federated read. Server-side RBAC still applies — an unreadable
# UUID fails recall. Find UUIDs via /cognee-forget (lists datasets with ids).
# COGNEE_PLUGIN_READ_DATASET_IDS='["3f2b8ac6-1d5e-4f7a-9c3b-2e8d7a6b5c4f"]'

# ── Shared agent memory (v0.4) ───────────────────────────────────────────
# A provisioned plugin agent is its own user; cognee's grants flow child→parent
# only, so shared agent memory wires a tenant + a "cognee-agent" role holding
# read+write on the parent's datasets, and every agent writes to one canonical
# parent-owned dataset per name (addressed by UUID). Capability-gated: servers
# without the create-only provision contract (incl. cognee 1.6.0) get ZERO
# provisioning/wiring calls — pi keeps the single-principal behavior.
# Identity policy: auto (default — provision only to enable shared memory,
# fall back to the principal on any obstacle) | true (explicit; obstacles are
# errors/warnings) | false (principal only). Invalid → reference error surfaced
# as a config warning, behaves as auto:
# COGNEE_PLUGIN_IDENTITY=auto
# Sharing (default on; off exactly on 0/false/no/off — the agent then LEAVES
# the shared role and writes its own private dataset; re-enable to rejoin):
# COGNEE_SHARED_AGENT_MEMORY=true

# ── Behavior ─────────────────────────────────────────────────────────────
# COGNEE_CAPTURE=true          # master switch for auto-capture + auto-recall
# COGNEE_CONTEXT_MAX_CHARS=2000  # cap for the injected recall context block
# COGNEE_AUTO_IMPROVE_EVERY=150  # auto-sync session→graph every N writes (0=off)
# COGNEE_IMPROVE_COOLDOWN_MS=1800000  # min spacing between AUTOMATIC syncs —
#   # persisted in ~/.cognee-plugin/pi/improve-state/, honored across restarts
#   # (final/manual/switch syncs are never gated)
# COGNEE_FINAL_SYNC=true         # bounded shutdown flush; anything unflushed stays
#   # in the disk bridge and replays at the next launch

# ── Idle bridge + write bridge (v0.4) ────────────────────────────────────
# After a turn settles, one bounded timer counts quiet time; when it fires the
# session is improved once (the analog of the official plugins' idle watcher —
# no detached process). A throttled fire re-arms once at the cooldown's expiry.
# COGNEE_IDLE_IMPROVE=true        # false disarms the idle trigger alone
# COGNEE_IDLE_THRESHOLD_MS=60000 # quiet time before the idle improve fires
# COGNEE_DRAIN_BUDGET_MS=20000   # background drain time box
# Buffered writes spill to ~/.cognee-plugin/pi/bridge/<session>.json and replay
# (with fingerprint dedupe for may-have-committed sends) at the next launch —
# COGNEE_BUFFER_LIMIT (below) bounds the file with drop-oldest.

# ── Statusline segments (v0.4) ───────────────────────────────────────────
# pi's footer line: <glyph>cognee: <mode> · <dataset>[ · N awaiting replay]
# [ · N memory hits · X/Y turns had hits this session][ · credits: …]
# COGNEE_STATUSLINE_COUNTS=full  # diagnostic strip (recall <graph>g/<code>c);
#   # false/0/off hides the recall segment; unset = the compact form
# COGNEE_STATUSLINE_CREDITS=true # false hides the render-only credits segment
#   # (cloud mode; read from the shared ~/.cognee-plugin/claude-code/credits.json
#   #  written by the Claude Code/Codex plugins — pi never writes it)
# COGNEE_BILLING_URL="https://platform.cognee.ai/billing"  # low-balance top-up hint
# COGNEE_CREDITS_FILE="/path/to/credits.json"  # explicit marker path override

# ── Tool-call trace capture (v0.4) ───────────────────────────────────────
# Every allowed tool call is stored as a trace entry in the session cache
# (same tier as the QA pairs; promoted into the graph by /cognee-sync).
# Allowlist: pipe-separated globs or a JSON array. The default is the official
# plugins' PostToolUse matcher translated to pi tool names — a custom value
# REPLACES it (widen to custom/MCP tools or narrow as you like):
# COGNEE_CAPTURE_TOOLS="bash|powershell|read|write|edit|grep|find|ls"
# COGNEE_CAPTURE_TOOLS="read|write|mcp__*"   # example custom set
# Sensitive-path deny list: comma-separated globs or a JSON array EXTENDING
# the compiled-in list (.env*, *.pem, *.key, id_rsa*, .npmrc, .netrc,
# */.aws/credentials, */.ssh/*, *.p12, *.pfx, secrets.*, credentials.*).
# A hit refuses the WHOLE entry (never partially redacted):
# COGNEE_CAPTURE_DENY_PATHS="*.tfvars,*.tfstate"
# Redaction: private keys, connection URIs, bearer/basic tokens, credential
# key=value pairs, vendor keys (sk-*, gh*_ , github_pat_, xox*, whsec_),
# bcrypt hashes, and dict values under secret-ish keys are replaced BEFORE
# truncation so a clipped secret can never escape matching:
# COGNEE_CAPTURE_REDACT=true    # false disables trace redaction (not advised)
# Custom regexes, newline-separated (or a JSON array) — newlines keep commas
# usable inside patterns; each replaces matches with [redacted:custom]:
# COGNEE_CAPTURE_REDACT_PATTERNS="(?i)internal-[a-z0-9]{8,}"

# ── Timeouts / resilience (ms unless noted) ──────────────────────────────
# COGNEE_RECALL_TIMEOUT_MS=4000
# COGNEE_REQUEST_TIMEOUT_MS=10000
# COGNEE_HEALTH_TIMEOUT_MS=2500
# COGNEE_IMPROVE_SUBMIT_TIMEOUT_MS=60000
# COGNEE_REMEMBER_WAIT_SECONDS=8
# COGNEE_REMEMBER_BACKGROUND=true # false = synchronous, immediately-queryable remember write
# COGNEE_BUFFER_LIMIT=100         # bounds the in-memory queue AND the disk bridge file
# COGNEE_BREAKER_THRESHOLD=5
# COGNEE_BREAKER_WINDOW_MS=300000
# COGNEE_BREAKER_COOLDOWN_MS=120000

# ── Misc ─────────────────────────────────────────────────────────────────
# COGNEE_ENV_FILE="~/.cognee/.env"  # env file path override
# COGNEE_PI_STATE_DIR="~/.cognee-plugin/pi"  # pi state (active-dataset.json,
#   breaker.json, bootstrap.log); its PARENT is the shared bootstrap root
#   (venv, locks, pidfile) — override both together for tests
