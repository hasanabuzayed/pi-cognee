{
	"name": "@hasanabuzayed/pi-cognee",
	"version": "0.7.0",
	"description": "Cognee persistent memory for the pi coding agent — native extension with auto-capture, auto-recall, and knowledge-graph tools. Fail-soft by design: pi keeps working when the cognee server is down.",
	"license": "MIT",
	"main": "src/index.ts",
	"files": [
		"src",
		"README.md",
		".env.example",
		"LICENSE"
	],
	"keywords": [
		"pi-package",
		"pi",
		"pi-extension",
		"cognee",
		"memory",
		"persistent-memory",
		"agent-memory",
		"knowledge-graph",
		"rag",
		"graphrag"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hasanabuzayed/pi-cognee.git"
	},
	"bugs": {
		"url": "https://github.com/hasanabuzayed/cognee/issues"
	},
	"homepage": "https://github.com/hasanabuzayed/pi-cognee#readme",
	"scripts": {
		"build": "tsc",
		"prepublishOnly": "npm run build"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"devDependencies": {
		"typescript": "^5.5.0"
	}
}
