  "main": "src/index.ts",
  "files": [
    "src",
    "README.md",
    ".env.example"
  ],
  "keywords": [
    "pi-package",
    "pi-extension",
    "cognee",
    "memory",
    "agent-memory",
    "knowledge-graph",
    "persistent-memory"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/topoteretes/cognee-integrations.git",
    "directory": "pi/pi-cognee"
  },
  "bugs": {
    "url": "https://github.com/topoteretes/cognee-integrations/issues"
  },
  "homepage": "https://github.com/topoteretes/cognee-integrations/tree/main/pi/pi-cognee#readme",
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
